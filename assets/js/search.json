{% assign visible_posts = site.posts | where_exp: "item", "item.hidden != 'True'" | where_exp: "item", "item.hidden != 'true'" | where_exp: "item", "item.hidden != true" %}
[
{% for post in visible_posts %}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "pitu_id": {{ post.pitu_id | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
