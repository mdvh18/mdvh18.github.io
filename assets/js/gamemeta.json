---
layout: null
---
{% assign first_item = true %}
{
  {% for post in site.posts %}{% if post.pitu_id and post.pitu_id != "" %}{% unless first_item %},{% endunless %}{% assign first_item = false %}
  {{ post.pitu_id | append: "" | strip | jsonify }}: {
    "title": {{ post.namebanner | default: post.title | jsonify }},
    "date": {{ post.date | jsonify }},
    "price": {{ post.price | default: "free" | jsonify }},
    "platform": {{ post.platform | default: "PC" | jsonify }},
    "typegame": {{ post.typegame | jsonify }},
    "engine": {{ post.engine | default: "" | jsonify }},
    "dungluong": {{ post.dungluong | default: "" | jsonify }},
    "gametype": {{ post.gametype | default: "" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "url": {{ post.url | jsonify }}
  }{% endif %}{% endfor %}
  {% for post in site.pages %}{% if post.pitu_id and post.pitu_id != "" %}{% unless first_item %},{% endunless %}{% assign first_item = false %}
  {{ post.pitu_id | append: "" | strip | jsonify }}: {
    "title": {{ post.namebanner | default: post.title | jsonify }},
    "date": {{ post.date | jsonify }},
    "price": {{ post.price | default: "free" | jsonify }},
    "platform": {{ post.platform | default: "PC" | jsonify }},
    "typegame": {{ post.typegame | jsonify }},
    "engine": {{ post.engine | default: "" | jsonify }},
    "dungluong": {{ post.dungluong | default: "" | jsonify }},
    "gametype": {{ post.gametype | default: "" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "url": {{ post.url | jsonify }}
  }{% endif %}{% endfor %}
}
